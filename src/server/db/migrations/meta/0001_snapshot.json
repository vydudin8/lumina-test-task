        "audit_actor": {
          "name": "audit_actor",
          "value": "\"audit_events\".\"actor_role\" IN ('rep', 'lead', 'system') AND (\"audit_events\".\"actor_role\" = 'system') = (\"audit_events\".\"actor_id\" LIKE 'system:%')"
        },
        "audit_decision": {
          "name": "audit_decision",
          "value": "\"audit_events\".\"decision\" IN ('approved', 'rejected', 'overridden', 'blocked')"
        },
        "audit_reason_required": {
          "name": "audit_reason_required",
          "value": "(\"audit_events\".\"decision\" IS DISTINCT FROM 'rejected' AND \"audit_events\".\"action\" NOT IN ('company.merged', 'company.unmerged', 'field.overridden')) OR btrim(coalesce(\"audit_events\".\"reason\", '')) <> ''"
