DATABASE_URL=postgres://lumina:lumina@localhost:5432/lumina
TEST_DATABASE_URL=postgres://lumina:lumina@localhost:5432/lumina_test
SESSION_SECRET=dev-only-secret-change-me-0123456789abcdef
LOG_LEVEL=info
MAIL_WEBHOOK_SECRET=dev-webhook-secret
FAKE_WORLD_URL=http://localhost:4000
# Dev only: lets you switch fake-world into timeout / error / webhook-chaos modes (POST :4000/__control).
FAKE_WORLD_CONTROLS=1
# Mail status reconciliation: every INTERVAL ms ask the provider about up to BATCH cards stuck in one status for STALE ms.
MAIL_RECONCILE_INTERVAL_MS=60000
MAIL_RECONCILE_BATCH=20
MAIL_RECONCILE_STALE_MS=3600000
