{
	"name": "lumina-test-task",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.28.9",
	"engines": {
		"node": ">=24"
	},
	"imports": {
		"#client/*": "./src/client/*",
		"#common/*": "./src/common/*",
		"#server/*": "./src/server/*",
		"#fake-world/*": "./src/fake-world/*"
	},
	"scripts": {
		"dev": "pnpm run --parallel \"/^dev:/\"",
		"dev:app": "node --env-file-if-exists=.env --watch src/server/main.ts",
		"dev:web": "vite",
		"dev:fake-world": "node --env-file-if-exists=.env --watch src/fake-world/main.ts",
		"build": "vite build",
		"start": "node src/server/db/migrate.ts && node src/server/seed/main.ts && node src/server/main.ts",
		"migrate": "node --env-file-if-exists=.env src/server/db/migrate.ts",
		"seed": "node --env-file-if-exists=.env src/server/seed/main.ts",
		"seed:reset": "node --env-file-if-exists=.env src/server/seed/main.ts --reset",
		"db:generate": "drizzle-kit generate",
		"lint": "tsc && eslint . && prettier --check .",
		"format": "prettier --write . && eslint --fix .",
		"test": "pnpm lint && vitest run",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"test:all": "pnpm test && pnpm test:e2e",
		"fixtures": "node scripts/generate-fixtures.ts"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^1.10.0",
		"@hono/node-server": "^2.1.9",
		"@tanstack/react-query": "^5.108.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cn": "^0.5.2",
		"decimal.js": "^10.6.0",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.19",
		"lucide-react": "^1.76.0",
		"pg": "^8.23.1",
		"pino": "^10.4.0",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.5.2",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.8",
		"globals": "^17.14.0",
		"jiti": "^2.7.0",
		"prettier": "^3.10.1",
		"prettier-plugin-organize-imports": "^4.3.0",
		"tailwindcss": "^4.3.5",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	}
}
